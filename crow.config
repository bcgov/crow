# Crow project memory. This file is safe to commit to a public repository.
# Do not add internal URLs, credentials, tokens, passwords, absolute paths, or
# copied provider responses. Use the private reference names below instead.

spec_version: "1.0"

project:
  id: "crow"
  name: "Crow"
  repository:
    provider: "github"
    owner: "bcgov"
    name: "crow"
    visibility: "public"

# Sonar settings consumed by crow-sonar-scan.
sonar:
  projectKey: "crow"
  projectName: "Crow"
  exclusions:
    - "**/build/**"
    - "**/evidence/**"
    - "**/.scannerwork/**"
    - "**/.codebase-memory/**"
  useMsBuild: false
  runTests: false

# CI/CD references are either repository-relative (safe to commit) or symbolic
# provider references resolved through an authenticated Raven/MCP connection.
ci_cd:
  - id: "crow-assets-validation"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "crow"
      visibility: "public"
    workflow_path: ".github/workflows/crow-assets.yml"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:ci:crow-assets-validation"
    discovered:
      source: "repository"
      recorded_by: "crow"
      recorded_on: "2026-09-10"

  # Add application-specific pipelines using a symbolic resource_ref. Never
  # copy an internal pipeline URL into this file.
  - id: "primary"
    provider: "discover"
    lookup:
      mode: "provider"
      connection_ref: "raven:ci-cd"
      resource_ref: "crow:ci:primary"

# Work tracking references identify a provider and a lookup name without
# disclosing a private board URL, project URL, or query endpoint.
work_tracking:
  - id: "public-github-issues"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "crow"
      visibility: "public"
    issue_source: "repository"
    board:
      mode: "provider"
      connection_ref: "raven:github"
      resource_ref: "crow:work-tracking:github-board"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:work-tracking:github-issues"

  - id: "primary"
    provider: "discover"
    lookup:
      mode: "provider"
      connection_ref: "raven:work-tracking"
      resource_ref: "crow:work-tracking:primary"
      issue_query_ref: "crow:work-tracking:primary-query"

related_repositories:
  - id: "raven"
    provider: "github"
    owner: "bcgov"
    name: "raven"
    visibility: "public"
    relationship: "MCP integration and protected credential-storage reference"
    paths:
      - "scripts/setup-credentials.ps1"
      - "scripts/setup-credentials-mac.mjs"

documentation:
  - id: "readme"
    source: "local"
    path: "README.md"
  - id: "sonar-scan-skill"
    source: "local"
    path: ".apm/skills/crow-sonar-scan/SKILL.md"
  - id: "architecture-review-skill"
    source: "local"
    path: ".apm/skills/crow-architecture-review/SKILL.md"
  - id: "security-review-skill"
    source: "local"
    path: ".apm/skills/crow-security-review/SKILL.md"
  - id: "external-project-documentation"
    source: "provider"
    provider: "discover"
    lookup:
      connection_ref: "raven:documentation"
      resource_ref: "crow:documentation:primary"

# Resolution rules for agents maintaining this file as project memory.
memory_policy:
  visibility: "public-reference-only"
  private_overlay: "~/.crow/crow.config.local"
  allowed_values:
    - "provider names"
    - "public repository owner/name"
    - "repository-relative paths"
    - "workflow or pipeline names confirmed public"
    - "symbolic connection_ref and resource_ref names"
  forbidden_values:
    - "internal URLs or hostnames"
    - "credentials, tokens, passwords, or secret values"
    - "absolute local paths"
    - "provider response bodies"
  update_rule: "When a user supplies a resource URL, retain only a safe provider/repository/path descriptor or a symbolic resource_ref; keep the URL in Raven/provider storage or the private overlay."
