        "role": {
          "type": ["string", "null"],
          "enum": ["Public service", "Shared platform", "Canonical register", "Internal system", "Point solution", "Integration adapter", "Unknown", null]
        },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": ["string", "null"], "enum": ["Verified", "Inferred", "Unknown", "N/A", null] },
        "consumer_count": { "type": ["integer", "null"], "minimum": 0 },
        "reuse_decision": { "type": ["string", "null"] },
        "data_custodian": { "type": ["string", "null"] },
        "data_sharing_spectrum": { "type": ["string", "null"], "enum": ["Open", "Shared", "Closed", "Unknown", null] },
        "contract_owner": { "type": ["string", "null"] },
        "degradation_behavior": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "platform_metrics": {
      "type": ["object", "null"],
      "description": "Optional measured counts or rates with source evidence. Do not derive or invent a maturity score.",
      "properties": {
        "shared_dependency_count": { "type": ["integer", "null"], "minimum": 0 },
        "known_consumer_count": { "type": ["integer", "null"], "minimum": 0 },
        "contracts_with_owner_count": { "type": ["integer", "null"], "minimum": 0 },
        "fallback_scenarios_tested_count": { "type": ["integer", "null"], "minimum": 0 },
        "evidence": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Informational", "CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
          },
          "classification": { "type": "string", "enum": ["Confirmed", "Probable", "Informational"] },
          "business_risk": { "type": "string" },
          "action": { "type": "string" }
        },
        "required": ["title", "severity", "classification", "business_risk", "action"],
        "additionalProperties": false
      }
    }
  },

