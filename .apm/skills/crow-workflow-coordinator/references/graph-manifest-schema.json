{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrowGraphManifest",
  "description": "Schema for Crow workflow coordinator dependency graph manifests (DAG)",
  "type": "object",
  "required": [
    "version",
    "graph_id",
    "title",
    "nodes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "graph_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "default": 4
    },
    "isolated_worktree": {
      "type": "boolean",
      "default": true
    },
    "worktree_path": {
      "type": "string"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "prompt",
        "manifest_hash",
        "none"
      ],
      "default": "prompt"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "asset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "read_only",
              "mutation",
              "verification",
              "barrier"
            ]
          },
          "asset": {
            "type": "string",
            "description": "Crow skill or agent name (e.g., crow-security-review, crow-testing)",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "uniqueItems": true
          },
          "command": {
            "type": "string",
            "description": "Optional deterministic verification or execution script command",
            "minLength": 1
          },
          "mutation_targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "forbidden_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "verifier": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "command",
                  "file_exists"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "target"
            ],
            "additionalProperties": false
          },
          "fallback": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "abort"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
